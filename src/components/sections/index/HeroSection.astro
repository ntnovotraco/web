---
const slides = [
  '/images/slide-hero-1.webp',
  '/images/slide-hero-2.webp',
  '/images/slide-hero-3.webp',
  '/images/slide-hero-4.webp',
];
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    {slides.map((src, i) => (
      <div
        class="hero__slide"
        style={`background-image: url(${src}); animation-delay: ${i * 5}s;`}
      />
    ))}
  </div>

  <div class="hero__content">
    <div class="hero__inner">

      <div class="hero__left">
        <p class="hero__subtitle font-subtitle">NÃO PRODUZIMOS EVENTOS</p>
        <h1 class="hero__title font-title">Nós construímos o que não se esquece.</h1>
      </div>

      <div class="hero__right">
        <p class="hero__text font-body">19 anos nos bastidores, enquanto construíamos um legado sociocultural</p>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-dark);
    color: var(--color-light);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: hero-fade 20s ease-in-out infinite;
  }

  @keyframes hero-fade {
    0% { opacity: 0; }
    2% { opacity: 1; }
    23% { opacity: 1; }
    25% { opacity: 0; }
    100% { opacity: 0; }
  }

  .hero__content {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
  }

  .hero__inner {
    max-width: 1255px;
    width: 100%;
    margin: 0 auto;
    padding: 0 0px 90px;
    display: flex;
    align-items: flex-end;
    gap: 20px;
    justify-content: space-between;
  }

  .hero__left {
    max-width: 578.55px;
    display: flex;
    flex-direction: column;
    gap: 48.3px;
  }

  .hero__subtitle {
    margin: 0;
  }

  .hero__title {
    margin: 0;
    font-size: 66.335px;
  }

  .hero__right {
    width: 355.95px;
    flex-shrink: 0;
  }

  .hero__text {
    margin: 0;
    max-width: 236px;
    margin-left: auto;
    text-align: right;
  }

  @media (max-width: 1200px) {
    .hero__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 0 16px 48px;
    }
    .hero__title {
      font-size: 32px;
      text-align: center;
      max-width: 300px;
    }
    .hero__right {
      width: 100%;
      text-align: center;
    }
    .hero__left {
      gap: 20px;
      margin: 0 auto;
    }

    .hero__text {
      margin-left: 0;
      text-align: center;
      max-width: 100%;
    }

    .hero__subtitle {
      text-align: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      height: 563px;
      min-height: 563px;
    }

    .hero__slide::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(25, 23, 24, 0.00) 47.2%, #191718 100%);
    }

    .hero__inner {
      max-width: 300px;
      padding-left: 0px;
      padding-right: 0px;
    }
  }
</style>
