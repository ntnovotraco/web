<footer class="lp-footer">
  <div class="lp-footer__brand">
    <img
      src="/images/lp/logo-nt-footer.svg"
      alt="Novo Traço"
      class="lp-footer__logo"
    />
    <div class="lp-footer__links">
      <p>Uma realização Novo Traço.</p>
      <a href="/lp/politicas" class="underline">Políticas de privacidade</a>
    </div>
  </div>
  <p class="lp-footer__cnpj">
    NOVO TRACO PUBLICIDADE E PROPAGANDA LTDA. CNPJ: 04.582.964/0001-46
  </p>
</footer>

<style>
  .lp-footer {
    background: var(--color-lp-dark);
    border-top: 1px solid rgba(2, 3, 5, 0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 48px 24px;
  }

  .lp-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .lp-footer__logo {
    width: 40px;
    height: 48px;
  }

  .lp-footer__links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--color-lp-light);
    font-size: 14px;
    line-height: 20px;
    text-align: center;
  }

  .lp-footer__cnpj {
    color: var(--color-lp-light);
    font-size: 12px;
    line-height: 16px;
    text-align: center;
    max-width: 747px;
  }

  @media (max-width: 768px) {
    .lp-footer {
      padding: 16px;
    }

    .lp-footer__logo {
      width: 35px;
      height: 40px;
    }

    .lp-footer__links {
      font-size: 12px;
      line-height: 12px;
    }

    .lp-footer__cnpj {
      font-size: 10px;
      line-height: 12px;
      max-width: 215px;
    }
  }
</style>
