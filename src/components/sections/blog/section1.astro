---
import { getCollection, getEntry } from 'astro:content';
import ArticleCard from '../../ui/ArticleCard.astro';

const allPosts = await getCollection('posts');
const categorias = await getCollection('categorias');

const postsComCategoria = await Promise.all(
  allPosts.map(async (post) => {
    const cat = await getEntry(post.data.categoria);
    return {
      image: post.data.imagemDestacada,
      categoryLabel: cat?.data.nome ?? '',
      categoryColor: cat?.data.cor ?? '#191718',
      categoryId: cat?.id ?? '',
      title: post.data.titulo,
      excerpt: post.data.resumo,
      readTime: post.data.tempoDeLeitura,
      href: `/blog/${post.data.slug}`,
    };
  })
);

const categoriasOrdenadas = [...categorias].sort((a, b) =>
  a.data.nome.localeCompare(b.data.nome)
);
---

<section class="section1">
  <div class="section1__inner">

    <div class="section1__filters" id="blog-filters">
      <button class="section1__filter section1__filter--active" data-category="todos">Todos</button>
      {categoriasOrdenadas.map((cat) => (
        <button class="section1__filter" data-category={cat.id}>{cat.data.nome}</button>
      ))}
    </div>

    <div class="section1__grid" id="blog-grid">
      {postsComCategoria.map((post, i) => (
        <div
          class:list={['section1__card', { 'section1__card--hidden': i >= 6 }]}
          data-category={post.categoryId}
        >
          <ArticleCard {...post} />
        </div>
      ))}
    </div>

    {postsComCategoria.length > 6 && (
      <div class="section1__loadmore" id="blog-loadmore">
        <button class="section1__btn" id="blog-loadmore-btn">Ver mais artigos</button>
      </div>
    )}

  </div>
</section>

<style>
  .section1 {
    width: 100%;
    background-color: var(--color-light);
    color: var(--color-dark);
  }

  .section1__inner {
    max-width: 1260px;
    margin: 0 auto;
    padding: 80px 0px;
    display: flex;
    flex-direction: column;
    gap: 67px;
  }

  .section1__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .section1__filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .section1__filters::-webkit-scrollbar {
      display: none;
    }
  }

  .section1__filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 24px;
    border: 1px solid rgba(25, 23, 24, 0.2);
    border-radius: 91px;
    background: transparent;
    color: var(--color-dark);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .section1__filter:hover {
    background: rgba(25, 23, 24, 0.06);
  }

  .section1__filter--active {
    background: var(--color-dark);
    color: var(--color-light);
    border-color: var(--color-dark);
  }

  .section1__filter--active:hover {
    background: var(--color-dark);
    color: var(--color-light);
  }

  .section1__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: flex-start;
  }

  .section1__card {
    display: block;
  }

  .section1__card--hidden {
    display: none;
  }

  .section1__loadmore {
    display: flex;
    justify-content: center;
  }

  .section1__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10.5px 26.25px;
    border: 1.05px solid var(--color-dark);
    border-radius: 283.5px;
    background: transparent;
    color: var(--color-dark);
    font-size: 16.8px;
    font-weight: 400;
    line-height: 1.3;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .section1__btn:hover {
    background: var(--color-dark);
    color: var(--color-light);
  }

  @media (max-width: 1280px) {
    .section1__inner {
      padding: 80px 16px;
    }
  }

  @media (max-width: 768px) {
    .section1__inner {
      gap: 40px;
    }

    .section1__filters {
      gap: 6px;
    }

    .section1__grid {
      gap: 24px;
      justify-content: center;
    }
  }
</style>

<script>
  const POSTS_PER_PAGE = 6;

  document.addEventListener('DOMContentLoaded', () => {
    const filters = document.querySelectorAll<HTMLButtonElement>('.section1__filter');
    const cards = document.querySelectorAll<HTMLElement>('.section1__card');
    const loadmoreWrap = document.getElementById('blog-loadmore');
    const loadmoreBtn = document.getElementById('blog-loadmore-btn');

    let activeCategory = 'todos';
    let visibleCount = POSTS_PER_PAGE;

    function update() {
      let matchingCards: HTMLElement[] = [];

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const matches = activeCategory === 'todos' || cat === activeCategory;
        if (matches) {
          matchingCards.push(card);
        }
      });

      matchingCards.forEach((card, i) => {
        if (i < visibleCount) {
          card.classList.remove('section1__card--hidden');
        } else {
          card.classList.add('section1__card--hidden');
        }
      });

      cards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        const matches = activeCategory === 'todos' || cat === activeCategory;
        if (!matches) {
          card.classList.add('section1__card--hidden');
        }
      });

      if (loadmoreWrap) {
        loadmoreWrap.style.display = visibleCount >= matchingCards.length ? 'none' : 'flex';
      }
    }

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        filters.forEach((b) => b.classList.remove('section1__filter--active'));
        btn.classList.add('section1__filter--active');
        activeCategory = btn.getAttribute('data-category') || 'todos';
        visibleCount = POSTS_PER_PAGE;
        update();
      });
    });

    loadmoreBtn?.addEventListener('click', () => {
      visibleCount += POSTS_PER_PAGE;
      update();
    });

    update();
  });
</script>
