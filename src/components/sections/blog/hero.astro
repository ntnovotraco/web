---
import { getCollection, getEntry } from 'astro:content';
import ButtonPill from '../../ui/ButtonPill.astro';

const allPosts = await getCollection('posts');
const ultimoEntry = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
)[0];

if (!ultimoEntry) {
  return;
}

const cat = await getEntry(ultimoEntry.data.categoria);
---

<section class="hero">
  <div class="hero__bg" style={`background-image: url('${ultimoEntry.data.imagemDestacada}');`} aria-hidden="true"></div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <div class="hero__inner">

      <div class="hero__left">
        <div class="hero__meta">
          <div class="hero__category">
            <span class="hero__dot" style={`background-color: ${cat?.data.cor};`}></span>
            <span class="hero__category-label">{cat?.data.nome}</span>
          </div>
          <span class="hero__readtime">{ultimoEntry.data.tempoDeLeitura}</span>
        </div>
        <h1 class="hero__title font-title">{ultimoEntry.data.titulo}</h1>
      </div>

      <div class="hero__right">
        <p class="hero__text font-body">{ultimoEntry.data.resumo}</p>
        <ButtonPill href={`/blog/${ultimoEntry.data.slug}`} variant="light">Ler artigo completo</ButtonPill>
      </div>

    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 600px;
    display: flex;
    flex-direction: column;
    background-color: var(--color-dark);
    color: var(--color-light);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(25, 23, 24, 0.85) 0%,
      rgba(25, 23, 24, 0.4) 60%,
      rgba(25, 23, 24, 0.2) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
  }

  .hero__inner {
    max-width: 1255px;
    width: 100%;
    margin: 0 auto;
    padding: 0 0px 100px;
    display: flex;
    align-items: flex-end;
    gap: 20px;
    justify-content: space-between;
  }

  .hero__left {
    max-width: 611px;
    display: flex;
    flex-direction: column;
    gap: 29px;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 29px;
  }

  .hero__category {
    display: flex;
    align-items: center;
    gap: 11.25px;
  }

  .hero__dot {
    width: 11.25px;
    height: 11.25px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero__category-label {
    font-size: 11.25px;
    font-weight: 400;
    line-height: 15px;
    letter-spacing: 0.5625px;
    text-transform: uppercase;
    color: var(--color-light);
  }

  .hero__readtime {
    font-size: 11.25px;
    font-weight: 400;
    line-height: 15px;
    color: rgba(240, 239, 235, 0.9);
  }

  .hero__title {
    margin: 0;
    font-size: 56px;
    line-height: 1.2;
    color: var(--color-light);
  }

  .hero__right {
    width: 327px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 29px;
    align-items: flex-end;
  }

  .hero__text {
    margin: 0;
    max-width: 327px;
    font-size: 18px;
    line-height: 1.4;
    text-align: right;
    color: var(--color-light);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 1280px) {
    .hero__inner {
      padding: 0 16px 60px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      height: auto;
      min-height: 580px;
    }

    .hero__bg {
      height: 335px;
      bottom: auto;
      inset: 0 auto auto 0;
      width: 100%;
    }

    .hero__overlay {
      background: linear-gradient(
        to bottom,
        rgba(15, 17, 19, 0) 40%,
        rgba(15, 17, 19, 1) 75%
      );
    }

    .hero__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 0 20px 40px;
      max-width: 354px;
      margin: 0 auto;
      padding-top: 241px;
    }

    .hero__left {
      gap: 20px;
    }

    .hero__meta {
      gap: 16px;
    }

    .hero__category-label {
      font-size: 10px;
      letter-spacing: 0.5px;
    }

    .hero__title {
      font-size: 32px;
      line-height: 1.2;
    }

    .hero__right {
      width: 100%;
      align-items: flex-start;
      gap: 24px;
    }

    .hero__text {
      text-align: left;
      max-width: 294px;
      font-size: 16px;
      line-height: 1.4;
      -webkit-line-clamp: 2;
    }
  }
</style>
