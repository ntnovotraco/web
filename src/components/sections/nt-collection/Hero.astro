    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .hero__header {
    display: flex;
    flex-direction: column;
    gap: 29px;
    max-width: 711px;
  }

  .hero__label {
    margin: 0;
  }

  .hero__title {
    margin: 0;
  }

