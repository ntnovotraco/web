---
const artistas = [
  { nome: 'Dora Morelembaum', titulo: 'A Arquitetura\ndo Invisível', imagem: '/images/nt-collections/carousel/dora.webp' },
  { nome: 'L7nnon', titulo: 'Profetize sua\nCriação', imagem: '/images/nt-collections/carousel/l7nnon.webp' },
  { nome: 'Rincon Sapiência', titulo: 'Das Suas Raízes\npara o Mundo', imagem: '/images/nt-collections/carousel/rincon.webp' },
  { nome: 'MC Pedrinho', titulo: 'Crie do Que\nVocê É', imagem: '/images/nt-collections/carousel/pedrinho.webp' },
  { nome: 'Carlos Prazeres', titulo: 'Ouça com\na Alma', imagem: '/images/nt-collections/carousel/carlos-prazeres.webp' },
  { nome: 'Rafaello Ramundo', titulo: 'A Economia\nda Emoção', imagem: '/images/nt-collections/carousel/rafaello.webp' },
  { nome: 'Kayk Maloka', titulo: 'Crie o Seu\nMundo', imagem: '/images/nt-collections/carousel/kayk.webp' },
  { nome: 'Froid', titulo: 'Não Existe\nConcorrência', imagem: '/images/nt-collections/carousel/froid.webp' },
  { nome: 'Jean Tassy', titulo: 'Crie Com o Que\nVocê Tem Dentro', imagem: '/images/nt-collections/carousel/jean.webp' },
  { nome: 'Duckjay', titulo: 'Construa Sua\nFrequência', imagem: '/images/nt-collections/carousel/duckjay.webp' },
  { nome: 'Mauro Henrique', titulo: 'Afine o\nSeu Canal', imagem: '/images/nt-collections/carousel/mauro.webp' },
  { nome: 'Papatinho', titulo: 'O "Músculo"\nCriativo', imagem: '/images/nt-collections/carousel/papatinho.webp' },
  { nome: 'Hamilton de Holanda', titulo: 'Improvise\nO Hábito de Criar', imagem: '/images/nt-collections/carousel/hamilton.webp' },
  { nome: 'Tasha & Tracie', titulo: 'Não peça\npermissão', imagem: '/images/nt-collections/carousel/tasha-tracie.webp' },
];

// Agrupa em blocos de 4 para o mobile
const chunks: typeof artistas[] = [];
for (let i = 0; i < artistas.length; i += 4) {
  chunks.push(artistas.slice(i, i + 4));
}
---

<section class="carousel-section">

  <!-- DESKTOP: AutoScroll contínuo -->
  <div id="artistas-splide-desktop" class="splide carousel-desktop" aria-label="Artistas NT Collection">
    <div class="splide__track">
      <ul class="splide__list">
        {artistas.map((artista) => (
          <li class="splide__slide">
            <div class="carousel__card">
              <img src={artista.imagem} alt={artista.nome} class="carousel__card-img" loading="lazy" />
              <div class="carousel__card-overlay"></div>
              <span class="carousel__badge">EM BREVE</span>
              <div class="carousel__card-content">
                <p class="carousel__card-title font-title">{artista.titulo}</p>
                <p class="carousel__card-name">{artista.nome}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- MOBILE: 1 slide = grade 2×2 -->
  <div id="artistas-splide-mobile" class="splide carousel-mobile" aria-label="Artistas NT Collection">
    <div class="splide__track">
      <ul class="splide__list">
        {chunks.map((grupo) => (
          <li class="splide__slide">
            <div class="mobile-grid">
              {grupo.map((artista) => (
                <div class="carousel__card">
                  <img src={artista.imagem} alt={artista.nome} class="carousel__card-img" loading="lazy" />
                  <div class="carousel__card-overlay"></div>
                  <span class="carousel__badge">EM BREVE</span>
                  <div class="carousel__card-content">
                    <p class="carousel__card-title font-title">{artista.titulo}</p>
                    <p class="carousel__card-name">{artista.nome}</p>
                  </div>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>

</section>

<style>
  .carousel-section {
    background-color: var(--color-light);
    border-top: 1px solid rgba(25, 23, 24, 0.21);
    padding: 124px 0;
    overflow: hidden;
  }

  /* ---- Desktop ---- */
  .carousel-mobile { display: none; }

  :global(#artistas-splide-desktop .splide__track) {
    overflow: visible;
  }

  :global(#artistas-splide-desktop .splide__list) {
    display: flex;
    align-items: stretch;
  }

  :global(#artistas-splide-desktop .splide__slide) {
    list-style: none;
    flex-shrink: 0;
  }

  :global(#artistas-splide-desktop .splide__pagination),
  :global(#artistas-splide-desktop .splide__arrows) {
    display: none !important;
  }

  :global(#artistas-splide-desktop .splide__sr) {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  /* ---- Cards (compartilhado) ---- */
  .carousel__card {
    position: relative;
    width: 267px;
    min-width: 267px;
    height: 400px;
    background-color: var(--color-dark);
    overflow: hidden;
    flex-shrink: 0;
  }

  .carousel__card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 40%, transparent 70%);
    z-index: 1;
  }

  .carousel__badge {
    position: absolute;
    top: 20px;
    left: 19px;
    background-color: #3AA845;
    border: 0.86px solid #3AA845;
    border-radius: 70px;
    padding: 8px 15px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.84px;
    color: var(--color-dark);
    line-height: 1.1;
    z-index: 2;
  }

  .carousel__card-content {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: #fff;
    text-align: center;
    z-index: 2;
  }

  .carousel__card-title {
    margin: 0;
    font-size: 32px;
    line-height: 0.91;
    white-space: pre-line;
  }

  .carousel__card-name {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    line-height: 1.1;
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .carousel-section {
      padding: 56px 0;
    }

    .carousel-desktop { display: none; }
    .carousel-mobile  { display: block; }

    :global(#artistas-splide-mobile .splide__track) {
      overflow: hidden;
    }

    :global(#artistas-splide-mobile .splide__list) {
      display: flex;
    }

    :global(#artistas-splide-mobile .splide__slide) {
      list-style: none;
      flex-shrink: 0;
      width: 100%;
    }

    :global(#artistas-splide-mobile .splide__pagination),
    :global(#artistas-splide-mobile .splide__arrows) {
      display: none !important;
    }

    :global(#artistas-splide-mobile .splide__sr) {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }

    .mobile-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5px;
      width: 100%;
      align-content: start;
    }

    /* No mobile os cards preenchem a célula da grid */
    .carousel-mobile .carousel__card {
      width: 100%;
      min-width: unset;
      height: auto;
      aspect-ratio: 2 / 3;
      flex-shrink: unset;
    }

    .carousel-mobile .carousel__card-title {
      font-size: 18px;
      line-height: 1;
    }

    .carousel-mobile .carousel__card-name {
      font-size: 8px;
    }

    .carousel-mobile .carousel__badge {
      font-size: 8px;
      padding: 4px 8px;
      top: 10px;
      left: 10px;
    }

    .carousel-mobile .carousel__card-content {
      bottom: 12px;
      left: 10px;
      right: 10px;
      gap: 6px;
    }
  }
</style>

<script>
  import Splide from '@splidejs/splide';
  import { AutoScroll } from '@splidejs/splide-extension-auto-scroll';
  import '@splidejs/splide/css/core';

  function init() {
    const isMobile = window.matchMedia('(max-width: 768px)').matches;

    if (!isMobile) {
      new Splide('#artistas-splide-desktop', {
        type: 'loop',
        drag: 'free',
        snap: false,
        arrows: false,
        pagination: false,
        autoWidth: true,
        gap: '7px',
        autoScroll: {
          speed: 0.6,
          pauseOnHover: true,
          pauseOnFocus: false,
        },
      }).mount({ AutoScroll });
    } else {
      new Splide('#artistas-splide-mobile', {
        type: 'loop',
        drag: true,
        snap: true,
        arrows: false,
        pagination: false,
        perPage: 1,
        perMove: 1,
        gap: '0px',
      }).mount();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
