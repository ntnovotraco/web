---
interface Props {
  href?: string;
  tag?: 'a' | 'button';
  variant?: 'default' | 'light';
}

const { href, tag = href ? 'a' : 'button', variant = 'default' } = Astro.props;
const Tag = tag;
---

<Tag class={`btn-pill${variant === 'light' ? ' btn-pill--light' : ''}`} {...(href ? { href } : { type: 'button' })} >
  <slot />
</Tag>

<style>
  .btn-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10.5px 26.25px;
    border: 1.05px solid var(--color-dark);
    border-radius: 283.5px;
    background: transparent;
    color: var(--color-dark);
    font-size: 16.8px;
    font-weight: 400;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .btn-pill:hover {
    background: var(--color-dark);
    color: var(--color-light);
  }

  /* variante light: maior especificidade para sobrescrever em seções escuras */
  .btn-pill.btn-pill--light {
    border-color: var(--color-light);
    color: var(--color-light);
    background: transparent;
  }
  .btn-pill.btn-pill--light:hover {
    background: var(--color-light);
    color: var(--color-dark);
    border-color: var(--color-light);
  }
</style>
